# Beast AI Trading Bot — environment template
# Copy to .env and fill values as needed.

# Runtime / Docker / Cloud staging
API_HOST=127.0.0.1
API_PORT=8000
# Cloud platforms inject PORT automatically (Render/Koyeb). Prefer PORT over API_PORT in staging.
BOT_AUTO_START=true
SITE_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=

# CORS (comma-separated). Staging also allows *.onrender.com / *.koyeb.app via CORS_ORIGIN_REGEX.
CORS_ORIGINS=
# CORS_ORIGIN_REGEX=https://.*\.(onrender\.com|koyeb\.app)

# Super-admin bootstrap (created on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123!

# Security / backups
CORS_ORIGINS=
AUTH_RATE_LIMIT=8
BACKUP_DIR=backups
BACKUP_KEY=

# Telegram (optional — mock mode used when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe (optional — mock checkout used when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_VIP=

# NOWPayments crypto (optional — mock USDT invoice used when unset)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Social OAuth (optional — demo mode used on localhost when unset)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
OAUTH_TWITTER_CLIENT_ID=
OAUTH_TWITTER_CLIENT_SECRET=
OAUTH_YAHOO_CLIENT_ID=
OAUTH_YAHOO_CLIENT_SECRET=
OAUTH_OUTLOOK_CLIENT_ID=
OAUTH_OUTLOOK_CLIENT_SECRET=

# Live Binance (Phase 3 scaffold — not required for paper trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=
